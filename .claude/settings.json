{
  "language": "portuguese",
  "outputStyle": "Direto",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auroq-sync.cjs --session-start",
            "timeout": 25000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auroq-sync.cjs --remind",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auroq-ate-o-fim.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
